# Environment configuration for the sports prediction site.
#
# Local development works WITHOUT this file - the defaults in config/settings.py
# are dev-safe. Copy this file to `.env` only if you need to override something
# locally, and NEVER commit `.env` or put a real secret in this example file.

# --- Django secret key -------------------------------------------------------
# REQUIRED in production (DEBUG=False). In development it is optional and falls
# back to an insecure throwaway value.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-50-plus-character-random-string

# --- Debug mode -------------------------------------------------------------
# "True" for local development (the default). MUST be "False" in production.
DEBUG=True

# --- Allowed hosts --------------------------------------------------------
# Comma-separated hostnames this site is served on.
# Defaults to "localhost,127.0.0.1" for local development.
# REQUIRED in production, e.g. ALLOWED_HOSTS=example.com,www.example.com
ALLOWED_HOSTS=localhost,127.0.0.1
