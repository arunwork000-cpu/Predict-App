# Environment configuration for the sports prediction site.
#
# Local development works WITHOUT this file - the defaults in config/settings.py
# are dev-safe. Copy this file to `.env` only if you need to override something
# locally, and NEVER commit `.env` or put a real secret in this example file.

# --- Django secret key -------------------------------------------------------
# REQUIRED in production (DEBUG=False). In development it is optional and falls
# back to an insecure throwaway value.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-50-plus-character-random-string

# --- Debug mode -------------------------------------------------------------
# "True" for local development (the default). MUST be "False" in production.
DEBUG=True

# --- Allowed hosts --------------------------------------------------------
# Comma-separated hostnames this site is served on.
# Defaults to "localhost,127.0.0.1" for local development.
# REQUIRED in production, e.g. ALLOWED_HOSTS=example.com,www.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database --------------------------------------------------------------
# Leave this unset for local development: the project falls back to SQLite
# (db.sqlite3). Set it in production to use PostgreSQL. Format:
#   DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/NAME
# Example (placeholder credentials only):
#   DATABASE_URL=postgres://predict_app:CHANGE_ME@localhost:5432/predict

# --- Email (password-reset links) -------------------------------------------
# Leave RESEND_API_KEY unset for local development: emails are printed to the
# console instead of being sent. In production, create an API key at
# https://resend.com and verify the domain you send from.
#   RESEND_API_KEY=re_xxxxxxxxxxxx
# The "From" address. Its domain must be verified in Resend.
#   DEFAULT_FROM_EMAIL=Sports Predictions <noreply@example.com>

# --- Match import (optional) -------------------------------------------------
# Imports fixtures and results from Flashscore data via the FlashLive Sports API
# on RapidAPI (https://rapidapi.com/tipsters/api/flashlive-sports). Leave
# RAPIDAPI_KEY unset to disable. Run: python manage.py sync_external_matches
#   RAPIDAPI_KEY=xxxxxxxxxxxx
# Tournaments to import fixtures from: FlashLive's full names (find them with
# manage.py sync_external_matches --list-tournaments --sport Football),
# comma-separated, "*" wildcards allowed. Empty = nothing is imported.
#   FLASHLIVE_TOURNAMENTS=England: Premier League,India: IPL,* ATP*,* WTA*
# Also import every match of these teams in any tournament, as Sport:Team.
#   FLASHLIVE_TEAMS=Cricket:India,Cricket:Australia
# Never import from tournaments matching these (wildcards allowed).
#   FLASHLIVE_EXCLUDE_TOURNAMENTS=*Doubles*,*Qualification*,*Test*
# Imported sports: Football, Tennis, Cricket, Badminton. Hockey (field hockey)
# is entered by hand; to import it, add its FlashLive ID (check with:
# manage.py sync_external_matches --list-sports)
#   FLASHLIVE_SPORT_IDS=Hockey=24
