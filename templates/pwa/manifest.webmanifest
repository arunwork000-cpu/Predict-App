{% load static %}{
  "name": "WinSports",
  "short_name": "WinSports",
  "description": "Free-to-play sports predictions",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#0B3D2E",
  "background_color": "#f8f9fa",
  "icons": [
    {"src": "{% static 'predictions/icons/icon-192.png' %}", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "{% static 'predictions/icons/icon-512.png' %}", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "{% static 'predictions/icons/icon-maskable-512.png' %}", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ]
}
